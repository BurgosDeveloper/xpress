# Base URL del backend
# Ejemplo: https://xpress-production-f0e7.up.railway.app/api
EXPO_PUBLIC_API_BASE_URL=

# Opcional (ruteo)
EXPO_PUBLIC_OSRM_BASE_URL=https://router.project-osrm.org

# Mapbox
# Token de acceso (runtime) usado por la app (JS).
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN

# Token de descargas (build-time) para resolver dependencias Android desde el repo Maven de Mapbox.
# Se usa en Gradle como `MAPBOX_DOWNLOADS_TOKEN`.
MAPBOX_DOWNLOADS_TOKEN=sk.YOUR_MAPBOX_DOWNLOADS_TOKEN

# Firma release Android local (opcional)
# Si se omiten, el build local puede caer al debug keystore.
XPRESS_UPLOAD_STORE_FILE=
XPRESS_UPLOAD_STORE_PASSWORD=
XPRESS_UPLOAD_KEY_ALIAS=
XPRESS_UPLOAD_KEY_PASSWORD=
